{
  "info": {
    "name": "Notification System API",
    "description": "Collection for testing the Notification System microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation {\\n  register(input: {\\n    email: \\\"test@example.com\\\"\\n    password: \\\"Test@123\\\"\\n    name: \\\"Test User\\\"\\n    preferences: [\\\"promotions\\\", \\\"order_updates\\\", \\\"recommendations\\\"]\\n  }) {\\n    user {\\n      id\\n      email\\n      name\\n    }\\n    token\\n  }\\n}\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation {\\n  login(input: {\\n    email: \\\"test@example.com\\\"\\n    password: \\\"Test@123\\\"\\n  }) {\\n    user {\\n      id\\n      email\\n      name\\n    }\\n    token\\n  }\\n}\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        }
      ]
    },
    {
      "name": "Notification Service",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"query {\\n  notifications(userId: \\\"{{userId}}\\\") {\\n    id\\n    type\\n    content\\n    read\\n    sentAt\\n  }\\n}\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation {\\n  markNotificationAsRead(id: \\\"{{notificationId}}\\\") {\\n    id\\n    read\\n  }\\n}\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        }
      ]
    },
    {
      "name": "Recommendation Service",
      "item": [
        {
          "name": "Track User Activity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation {\\n  trackUserActivity(input: {\\n    userId: \\\"{{userId}}\\\"\\n    productId: \\\"product1\\\"\\n    activityType: \\\"view\\\"\\n  })\\n}\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Get Recommendations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"query {\\n  recommendations(userId: \\\"{{userId}}\\\") {\\n    productId\\n    score\\n  }\\n}\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "your_jwt_token",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "your_user_id",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "your_notification_id",
      "type": "string"
    }
  ]
} 