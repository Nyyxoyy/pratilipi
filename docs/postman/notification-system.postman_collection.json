{
  "info": {
    "name": "Notification System",
    "description": "Collection for testing the Personalized Notification System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation { register(input: { email: \\\"test@example.com\\\", password: \\\"Test@123\\\", name: \\\"Test User\\\", preferences: [\\\"promotions\\\", \\\"order_updates\\\", \\\"recommendations\\\"] }) { user { id email name } token } }\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation { login(input: { email: \\\"test@example.com\\\", password: \\\"Test@123\\\" }) { user { id email name } token } }\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        }
      ]
    },
    {
      "name": "Recommendation Service",
      "item": [
        {
          "name": "Track User Activity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation { trackUserActivity(input: { userId: \\\"{{userId}}\\\", productId: \\\"product1\\\", activityType: \\\"view\\\" }) }\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Get Recommendations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"query { recommendations(userId: \\\"{{userId}}\\\") { productId score } }\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        }
      ]
    },
    {
      "name": "Notification Service",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"query { notifications(userId: \\\"{{userId}}\\\") { id type content read sentAt } }\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Get Unread Notifications",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"query { unreadNotifications(userId: \\\"{{userId}}\\\") { id type content sentAt } }\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"mutation { markNotificationAsRead(id: \\\"{{notificationId}}\\\") { id read } }\"}"
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "",
      "type": "string"
    }
  ]
} 